root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,yml,yaml,tf,md}]
indent_size = 2

# Reglas de estilo C# que el build debe hacer cumplir, no sugerir.
[*.cs]
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_diagnostic.CA2007.severity = none

# CA1848 exige delegados LoggerMessage en TODA llamada a ILogger. Es la recomendación correcta en la
# ruta caliente (la ingesta la aplica con [LoggerMessage]), pero convertir en error cada log de
# arranque o de diagnóstico añade ruido sin ganancia medible. Se degrada a sugerencia a conciencia.
dotnet_diagnostic.CA1848.severity = suggestion

# CA1515: en un host de ASP.NET los tipos públicos son la superficie natural del servicio.
dotnet_diagnostic.CA1515.severity = none

# CA1716 protege la interoperabilidad con lenguajes donde 'Error' es palabra reservada (VB.NET).
# Este dominio solo se consume desde C#, y 'Result'/'Error' es el vocabulario estándar del patrón:
# renombrarlo a DomainError empeoraría la legibilidad para protegerse de un consumidor inexistente.
dotnet_diagnostic.CA1716.severity = none

# Los tests usan Metodo_Condicion_ResultadoEsperado: el guion bajo separa las tres partes y hace que
# el nombre del test se lea como una frase en el informe de fallos. CA1707 protege la convención de
# nombres de una API pública, cosa que un ensamblado de tests no es.
[backend/tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1861.severity = none
