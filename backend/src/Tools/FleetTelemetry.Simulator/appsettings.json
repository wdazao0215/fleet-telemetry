{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Simulator": {
    "IngestionUrl": "http://localhost:8081/api/v1/telemetry",
