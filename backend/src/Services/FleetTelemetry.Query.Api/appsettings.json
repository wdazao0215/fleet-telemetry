{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "FleetDb": "Host=localhost;Port=5432;Database=fleet_telemetry;Username=fleet;Password=fleet_local_dev"
  },
  "Redis": { "ConnectionString": "localhost:6379", "AbortOnConnectFail": false },
