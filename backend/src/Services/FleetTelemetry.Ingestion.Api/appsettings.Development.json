{
  "_comment": "Apunta a la infraestructura que levanta docker-compose (timescaledb, redis y rabbitmq publican sus puertos en localhost). Permite ejecutar el servicio con 'dotnet run' contra esos contenedores sin definir ni una variable de entorno.",
"ConnectionStrings": {
    "FleetDb": "Host=localhost;Port=5432;Database=fleet_telemetry;Username=fleet;Password=fleet_local_dev"
  },
  "Redis": {
    "ConnectionString": "localhost:6379,password=fleet_local_dev",
    "AbortOnConnectFail": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "fleet",
    "Password": "fleet_local_dev"
  },
  "Ingestion": {
    "ApiKey": "dev-fleet-key"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:3000"]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": { "Microsoft.AspNetCore": "Warning" }
    }
  }
}
