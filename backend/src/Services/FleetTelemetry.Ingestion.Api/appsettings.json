{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
      }
    }
  },
  "Ingestion": {
    "ApiKey": "dev-fleet-key"
  },
  "Cors": { "AllowedOrigins": ["http://localhost:3000"] },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "AbortOnConnectFail": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "guest",
    "Password": "guest"
  },
  "Telemetry": {
    "DeduplicationWindowSeconds": 10,
    "StoppedRadiusMeters": 10,
    "StoppedThresholdSeconds": 60
  },
  "AllowedHosts": "*"
}
