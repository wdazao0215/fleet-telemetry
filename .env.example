# Copia este archivo a .env antes de levantar el entorno: cp .env.example .env
# Los valores por defecto son de desarrollo local. En AWS estos secretos vienen de Secrets Manager.

# --- PostgreSQL / TimescaleDB ---
POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet_local_dev
POSTGRES_DB=fleet_telemetry

# --- Redis ---
REDIS_PASSWORD=fleet_local_dev

# --- RabbitMQ ---
RABBITMQ_USER=fleet
RABBITMQ_PASSWORD=fleet_local_dev

# --- Seguridad de la aplicación ---
# API Key que el dispositivo/simulador presenta en la ingesta.
INGESTION_API_KEY=dev-fleet-key
# Clave de firma del JWT del dashboard. Mínimo 32 bytes para HS256.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-32b
JWT_ISSUER=fleet-telemetry
JWT_AUDIENCE=fleet-dashboard
# Credenciales del operador del dashboard (usuario semilla, no hay tabla de usuarios).
DASHBOARD_PASSWORD=fleet-dev
DASHBOARD_ORIGIN=http://localhost:3000

# --- Reglas de negocio (ajustables sin recompilar) ---
# Ventana de deduplicación en segundos.
TELEMETRY_DEDUPE_WINDOW_SECONDS=10
# Radio en metros por debajo del cual se considera que el vehículo no se ha movido.
TELEMETRY_STOPPED_RADIUS_METERS=10
# Segundos sin moverse tras los que se emite la alerta "Vehículo Detenido".
TELEMETRY_STOPPED_THRESHOLD_SECONDS=60

# --- Simulador ---
SIMULATOR_VEHICLE_COUNT=6
SIMULATOR_MIN_INTERVAL_MS=2000
SIMULATOR_MAX_INTERVAL_MS=5000
SIMULATOR_DUPLICATE_RATE=0.10
SIMULATOR_MALFORMED_RATE=0.05
